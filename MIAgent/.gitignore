.DS_Store
Thumbs.db

__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.codex-benchmark-runs/
.workbench_data/
.tmp/
# Keep environment templates, never deployment-specific values.
.env*
!.env.example
!.env.*.example
runtime/
.venv/
venv/
env/

# Keep the shared Markdown-preview setting, not personal editor state.
.vscode/*
!.vscode/settings.json
.idea/
.ipynb_checkpoints/
node_modules/

# Generated lab reports, caches, datasets, and downloaded model artifacts.
/build_reports/
/cache/
/model_cache/
/data/
/datasets/
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.nii
*.nii.gz
*.dcm
*.zip
*.tar
*.tar.gz
*.tgz

# Downloaded NVIDIA/MONAI bundles and model weights are local caches.
skills/segmentation/nv-segment-ct/bundle/
skills/segmentation/nv-segment-ct-finetune/bundle/

*.key
*.secret
*.secrets
*.secrets.json
*.secrets.yaml
*.local.yaml
skills/compute/profiles/*.local.*
outputs/
# Student inference is disposable. Keep only its documented contract in Git.
inference_tmp/*
!inference_tmp/README.md
# Local dashboard/browser artifacts
*.png
*.html.tmp

# Challenge run workspaces are local by default; keep the reusable template trackable.
challenge/*
!challenge/challenge_template/
!challenge/challenge_template/**
# The template exception above must not re-include generated bytecode.
challenge/challenge_template/**/__pycache__/

# Local gateway credential material is generated per deployment.
containers/gateway/htpasswd

# SLURM/runtime noise
*.out
*.err
*.log
tmp/
presentation/
# Keep small evidence files inside challenge_template trackable.

# Curated workshop screenshots and gateway preview assets are source files.
!/lab/images/*.png
!/containers/gateway/previews/*.png
