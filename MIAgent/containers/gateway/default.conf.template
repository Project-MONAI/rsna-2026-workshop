        proxy_send_timeout 3600s;
        proxy_set_header Host $miagent_paseo_authority;
        proxy_set_header X-Forwarded-Host $miagent_paseo_authority;
        proxy_set_header Origin "$miagent_external_scheme://$miagent_paseo_authority";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
