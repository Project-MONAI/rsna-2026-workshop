# Host dataset location; mounted read-only. No hosted API keys are required.
MIAgent_DATA_DIR=../data
MIAgent_SOLUTION_DIR=../MIAgent_solution
MIAgent_DOMAIN=miagent.local
# Optional custom browser-facing hostname (no scheme/port).
# Brev *.brevlab.com and *.gobrev.dev hosts are already allowed.
MIAgent_PUBLIC_HOST=localhost
MIAgent_HTTP_PORT=8088
MIAgent_ARCHIVE_VIEWER_PORT=8780
LOCAL_UID=1000
LOCAL_GID=1000
# Set to: stat -c %g /var/run/docker.sock
DOCKER_GID=983
# Local gateway routing value, not an external API credential.
MIAgent_CHAT_GATE_TOKEN=miagent-student-lab
# Access control is handled by Brev; no additional gateway login.
NVIDIA_API_KEY=
MIAgent_LLM_API_KEY=
MIAgent_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
OPENCODE_MODEL=miagent-llm/Qwen/Qwen3.8-27B-FP8
MIAgent_LLM_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
MIAgent_LLM_CACHE_VOLUME=miagent-qwen-cache
# Pin a tested vLLM image digest for distributing a lab release.
# MIAgent_VLLM_IMAGE=vllm/vllm-openai:nightly@sha256:...
